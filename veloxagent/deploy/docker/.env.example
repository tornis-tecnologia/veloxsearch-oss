# Velox Agent — docker compose settings. Copy to .env and fill in.
# The Mesh URL and token come from the console: Deployment > Mesh > Add agent.
VELOX_MESH_URL=https://<deployment>-mesh.<ip>.sslip.io
VELOX_ENROLL_TOKEN=
# true only for a Mesh behind an ingress serving its self-signed default
# certificate (sslip.io lab): the certificate is then NOT verified.
VELOX_AGENT_INSECURE=false
# The name the fleet shows for this host: echo "VELOX_AGENT_HOSTNAME=$(hostname)" >> .env
VELOX_AGENT_HOSTNAME=
# VELOX_AGENT_IMAGE=docker.io/tornistecnologia/velox-agent:0.2.0
